# Keep mock mode enabled until the ASP.NET Core backend endpoints are ready.
EXPO_PUBLIC_USE_MOCK_API=true

# Example local Android emulator URL: http://10.0.2.2:5000
# Example physical-device URL: http://192.168.1.10:5000
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_TIMEOUT_MS=10000


# Required for native Google Maps builds. Keep the real key outside source control.
GOOGLE_MAPS_API_KEY=
