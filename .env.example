EXPO_PUBLIC_API_URL=https://resqmob.runasp.net
EXPO_PUBLIC_API_TIMEOUT_MS=40000
EXPO_PUBLIC_UPLOAD_TIMEOUT_MS=130000

# Required for native Google Maps builds. Keep the real key outside source control.
GOOGLE_MAPS_API_KEY=

# Optional public support/contact channels. Unconfigured channels stay hidden.
EXPO_PUBLIC_SUPPORT_EMAIL=support@resq.app
# EXPO_PUBLIC_SUPPORT_PHONE=+9639XXXXXXXX
# EXPO_PUBLIC_SUPPORT_HOURS=الأحد - الخميس | 09:00 - 17:00
# EXPO_PUBLIC_WEBSITE_URL=https://resq.app
# EXPO_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page
# EXPO_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-page
# EXPO_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-page
